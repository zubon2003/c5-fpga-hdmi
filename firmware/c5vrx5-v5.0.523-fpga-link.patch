diff --git a/main/transport.c b/main/transport.c
index 5ccd0ec6..2c4498ff 100644
--- a/main/transport.c
+++ b/main/transport.c
@@ -45,8 +45,12 @@ static const void *tracker_program(void) { return s_p64; }
 /* 6-bit resistor DAC, LSB first (XIAO D4..D9; 8.2k/3.9k/2k/1k/470R/240R
