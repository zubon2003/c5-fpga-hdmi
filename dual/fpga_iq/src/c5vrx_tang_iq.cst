// C5VRX x2 -> Tang Primer 25K Dock -> HDMI 720p
// Pmod J4 (right): XIAO-A, Pmod J5 (middle): XIAO-B, Pmod J6 (left): HDMI,
// J3: Tang SDRAM module.  SDRAM / HDMI / S1 / clock pins as in Sipeed's
// nestang-25k (TangPrimer-25K-example).

IO_LOC "clk50" E2;
IO_PORT "clk50" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "s1" H11;
IO_PORT "s1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

// XIAO-A on Pmod J4 (adapter rev A: upper row CVBS0..2, lower row CVBS3..5)

// XIAO-B on Pmod J5

// HDMI Pmod on J6
IO_LOC "tmds_d_p[0]" H8,H7;
IO_PORT "tmds_d_p[0]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds_d_p[1]" G7,G8;
IO_PORT "tmds_d_p[1]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds_d_p[2]" F5,G5;
IO_PORT "tmds_d_p[2]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds_clk_p" H5,J5;
IO_PORT "tmds_clk_p" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// SDRAM on J3
IO_LOC "O_sdram_clk" E3;
IO_LOC "O_sdram_cs_n" K9;
IO_LOC "O_sdram_ras_n" L10;
IO_LOC "O_sdram_cas_n" K10;
IO_LOC "O_sdram_wen_n" J7;
IO_LOC "O_sdram_ba[0]" L9;
IO_LOC "O_sdram_ba[1]" K8;
IO_LOC "O_sdram_dqm[0]" L8;
IO_LOC "O_sdram_dqm[1]" L7;
IO_LOC "O_sdram_addr[0]" F6;
IO_LOC "O_sdram_addr[1]" F7;
IO_LOC "O_sdram_addr[2]" J10;
IO_LOC "O_sdram_addr[3]" J11;
IO_LOC "O_sdram_addr[4]" K7;
IO_LOC "O_sdram_addr[5]" H2;
IO_LOC "O_sdram_addr[6]" H1;
IO_LOC "O_sdram_addr[7]" H4;
IO_LOC "O_sdram_addr[8]" G4;
IO_LOC "O_sdram_addr[9]" J2;
IO_LOC "O_sdram_addr[10]" J8;
IO_LOC "O_sdram_addr[11]" J1;
IO_LOC "O_sdram_addr[12]" D1;
IO_LOC "IO_sdram_dq[0]" K2;
IO_LOC "IO_sdram_dq[1]" K1;
IO_LOC "IO_sdram_dq[2]" L1;
IO_LOC "IO_sdram_dq[3]" L2;
IO_LOC "IO_sdram_dq[4]" K4;
IO_LOC "IO_sdram_dq[5]" J4;
IO_LOC "IO_sdram_dq[6]" G1;
IO_LOC "IO_sdram_dq[7]" G2;
IO_LOC "IO_sdram_dq[8]" E1;
IO_LOC "IO_sdram_dq[9]" A1;
IO_LOC "IO_sdram_dq[10]" F2;
IO_LOC "IO_sdram_dq[11]" F1;
IO_LOC "IO_sdram_dq[12]" B2;
IO_LOC "IO_sdram_dq[13]" C2;
IO_LOC "IO_sdram_dq[14]" L4;
IO_LOC "IO_sdram_dq[15]" L3;

IO_PORT "O_sdram_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_ras_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_cas_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_wen_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_ba[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_ba[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_dqm[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_dqm[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_addr[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_addr[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_addr[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_addr[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_addr[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_addr[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_addr[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_addr[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_addr[8]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_addr[9]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_addr[10]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_addr[11]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_addr[12]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "IO_sdram_dq[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "IO_sdram_dq[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "IO_sdram_dq[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "IO_sdram_dq[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "IO_sdram_dq[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "IO_sdram_dq[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "IO_sdram_dq[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "IO_sdram_dq[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "IO_sdram_dq[8]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "IO_sdram_dq[9]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "IO_sdram_dq[10]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "IO_sdram_dq[11]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "IO_sdram_dq[12]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "IO_sdram_dq[13]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "IO_sdram_dq[14]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "IO_sdram_dq[15]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ---- XIAO-A IQ on Pmod J4 (right).  Firmware pin map (design/iq_link.md):
//      Q0..Q3 = D4 D5 D6 D7, I0..I3 = D8 D9 D0 D1
IO_LOC "xa_iq[0]" G11;   // Pmod 1  D4  Q0
IO_LOC "xa_iq[1]" D11;   // Pmod 2  D5  Q1
IO_LOC "xa_iq[2]" B11;   // Pmod 3  D6  Q2
IO_LOC "xa_iq[3]" G10;   // Pmod 7  D7  Q3 (sign)
IO_LOC "xa_iq[4]" D10;   // Pmod 8  D8  I0
IO_LOC "xa_iq[5]" B10;   // Pmod 9  D9  I1
IO_LOC "xa_iq[6]" C11;   // Pmod 4  D0  I2 (rev A: TP1)
IO_LOC "xa_iq[7]" C10;   // Pmod 10 D1  I3 (sign)
// ---- XIAO-B IQ on Pmod J5 (middle), same order
IO_LOC "xb_iq[0]" A11;
IO_LOC "xb_iq[1]" E11;
IO_LOC "xb_iq[2]" K11;
IO_LOC "xb_iq[3]" A10;
IO_LOC "xb_iq[4]" E10;
IO_LOC "xb_iq[5]" L11;
IO_LOC "xb_iq[6]" L5;
IO_LOC "xb_iq[7]" K5;
IO_PORT "xa_iq[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xa_iq[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xa_iq[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xa_iq[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xa_iq[4]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xa_iq[5]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xa_iq[6]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xa_iq[7]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xb_iq[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xb_iq[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xb_iq[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xb_iq[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xb_iq[4]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xb_iq[5]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xb_iq[6]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xb_iq[7]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
// ---- telemetry UARTs on the Dock USB-A port (direct FPGA pins, as used by
//      Sipeed nestang-25k for USB HID): D+ = XIAO-A, D- = XIAO-B
IO_LOC "xa_link" L6;
IO_PORT "xa_link" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "xb_link" K6;
IO_PORT "xb_link" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
