// C5VRX x2 -> Tang Primer 25K Dock -> HDMI 720p
// Pmod J4 (right): XIAO-A, Pmod J5 (middle): XIAO-B, Pmod J6 (left): HDMI,
// J3: Tang SDRAM module.  SDRAM / HDMI / S1 / clock pins as in Sipeed's
// nestang-25k (TangPrimer-25K-example).

IO_LOC "clk50" E2;
IO_PORT "clk50" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "s1" H11;
IO_PORT "s1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

// XIAO-A on Pmod J4 (adapter rev A: upper row CVBS0..2, lower row CVBS3..5)
IO_LOC "xa_cvbs[0]" G11;
IO_LOC "xa_cvbs[1]" D11;
IO_LOC "xa_cvbs[2]" B11;
IO_LOC "xa_cvbs[3]" G10;
IO_LOC "xa_cvbs[4]" D10;
IO_LOC "xa_cvbs[5]" B10;
IO_PORT "xa_cvbs[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xa_cvbs[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xa_cvbs[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xa_cvbs[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xa_cvbs[4]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xa_cvbs[5]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

// XIAO-B on Pmod J5
IO_LOC "xb_cvbs[0]" A11;
IO_LOC "xb_cvbs[1]" E11;
IO_LOC "xb_cvbs[2]" K11;
IO_LOC "xb_cvbs[3]" A10;
IO_LOC "xb_cvbs[4]" E10;
IO_LOC "xb_cvbs[5]" L11;
IO_PORT "xb_cvbs[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xb_cvbs[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xb_cvbs[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xb_cvbs[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xb_cvbs[4]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "xb_cvbs[5]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

// HDMI Pmod on J6
IO_LOC "tmds_d_p[0]" H8,H7;
IO_PORT "tmds_d_p[0]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds_d_p[1]" G7,G8;
IO_PORT "tmds_d_p[1]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds_d_p[2]" F5,G5;
IO_PORT "tmds_d_p[2]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds_clk_p" H5,J5;
IO_PORT "tmds_clk_p" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// SDRAM on J3
IO_LOC "O_sdram_clk" E3;
IO_LOC "O_sdram_cs_n" K9;
IO_LOC "O_sdram_ras_n" L10;
IO_LOC "O_sdram_cas_n" K10;
IO_LOC "O_sdram_wen_n" J7;
IO_LOC "O_sdram_ba[0]" L9;
IO_LOC "O_sdram_ba[1]" K8;
IO_LOC "O_sdram_dqm[0]" L8;
IO_LOC "O_sdram_dqm[1]" L7;
IO_LOC "O_sdram_addr[0]" F6;
IO_LOC "O_sdram_addr[1]" F7;
IO_LOC "O_sdram_addr[2]" J10;
IO_LOC "O_sdram_addr[3]" J11;
IO_LOC "O_sdram_addr[4]" K7;
IO_LOC "O_sdram_addr[5]" H2;
IO_LOC "O_sdram_addr[6]" H1;
IO_LOC "O_sdram_addr[7]" H4;
IO_LOC "O_sdram_addr[8]" G4;
IO_LOC "O_sdram_addr[9]" J2;
IO_LOC "O_sdram_addr[10]" J8;
IO_LOC "O_sdram_addr[11]" J1;
IO_LOC "O_sdram_addr[12]" D1;
IO_LOC "IO_sdram_dq[0]" K2;
IO_LOC "IO_sdram_dq[1]" K1;
IO_LOC "IO_sdram_dq[2]" L1;
IO_LOC "IO_sdram_dq[3]" L2;
IO_LOC "IO_sdram_dq[4]" K4;
IO_LOC "IO_sdram_dq[5]" J4;
IO_LOC "IO_sdram_dq[6]" G1;
IO_LOC "IO_sdram_dq[7]" G2;
IO_LOC "IO_sdram_dq[8]" E1;
IO_LOC "IO_sdram_dq[9]" A1;
IO_LOC "IO_sdram_dq[10]" F2;
IO_LOC "IO_sdram_dq[11]" F1;
IO_LOC "IO_sdram_dq[12]" B2;
IO_LOC "IO_sdram_dq[13]" C2;
IO_LOC "IO_sdram_dq[14]" L4;
IO_LOC "IO_sdram_dq[15]" L3;

IO_PORT "O_sdram_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_ras_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_cas_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_wen_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_ba[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_ba[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_dqm[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_dqm[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_addr[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_addr[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_addr[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "O_sdram_addr[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
