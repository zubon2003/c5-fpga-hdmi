diff --git a/v5/main/tang_link.c b/v5/main/tang_link.c
new file mode 100644
index 0000000..bc69651
--- /dev/null
+++ b/v5/main/tang_link.c
@@ -0,0 +1,71 @@
+/* C5VRX-5 Tang IQ link: receiver state packets for the FPGA (link_rx.v).
+ *
+ *   0 0xC5  1 seq  2 gain index  3 flags  4 channel  5 AFC offset (25 kHz)
+ *   6 signal strength 0..100  7 check (bytes 0..7 sum to 0)
+ *   flags: [1:0] IQ lane (2 = ultrafine, fixed in C5VRX-5) [2] carrier
+ *          [3] AFC locked [4] video seen in the last 200 ms [5] PAL
+ *
+ * A packet goes out after every gain write and at least every 2 ms. */
+#include "tang_link.h"
+#include "receiver.h"
+#include "rf.h"
+#include "driver/uart.h"
+#include "esp_timer.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+
+#define LINK_UART UART_NUM_1
+
+static TaskHandle_t s_task;
+static uint8_t s_seq;
+
+static void send_packet(void)
+{
+    int off = rf_offset_khz() / 25;
+    off = off < -128 ? -128 : off > 127 ? 127 : off;
+    int strength = s_signal_strength;
+    strength = strength < 0 ? 0 : strength > 100 ? 100 : strength;
+    bool video = esp_timer_get_time() - s_last_video_us < 200000;
+    uint8_t p[8] = {
+        0xC5, s_seq++, rf_gain(),
+        (uint8_t)(2u | (strength > 0 ? 4u : 0u) | (s_afc_locked ? 8u : 0u) |
+                  (video ? 16u : 0u) | (s_detected_std == VIDEO_STD_PAL ? 32u : 0u)),
+        (uint8_t)rf_channel_index(), (uint8_t)(int8_t)off, (uint8_t)strength, 0,
+    };
+    uint8_t sum = 0;
+    for (unsigned k = 0; k < 7; ++k) sum += p[k];
+    p[7] = (uint8_t)(0u - sum);
+    /* Straight into the TX FIFO (128 bytes): never blocks the caller. */
+    (void)uart_tx_chars(LINK_UART, (const char *)p, sizeof(p));
+}
+
+static void link_task(void *arg)
+{
+    (void)arg;
+    for (;;) {
+        (void)ulTaskNotifyTake(pdTRUE, pdMS_TO_TICKS(2));
+        send_packet();
+    }
+}
+
+void tang_link_start(void)
+{
+    const uart_config_t cfg = {
+        .baud_rate = TANG_LINK_BAUD,
+        .data_bits = UART_DATA_8_BITS,
+        .parity = UART_PARITY_DISABLE,
+        .stop_bits = UART_STOP_BITS_1,
+        .flow_ctrl = UART_HW_FLOWCTRL_DISABLE,
+        .source_clk = UART_SCLK_DEFAULT,
+    };
+    ESP_ERROR_CHECK(uart_driver_install(LINK_UART, 256, 0, 0, NULL, 0));
+    ESP_ERROR_CHECK(uart_param_config(LINK_UART, &cfg));
+    ESP_ERROR_CHECK(uart_set_pin(LINK_UART, TANG_LINK_GPIO, UART_PIN_NO_CHANGE,
+                                 UART_PIN_NO_CHANGE, UART_PIN_NO_CHANGE));
+    xTaskCreate(link_task, "tang_link", 2048, NULL, 2, &s_task);
+}
+
+void tang_link_kick(void)
+{
+    if (s_task) xTaskNotifyGive(s_task);
+}
diff --git a/v5/main/tang_link.h b/v5/main/tang_link.h
new file mode 100644
index 0000000..a6a815a
--- /dev/null
+++ b/v5/main/tang_link.h
@@ -0,0 +1,20 @@
+/* C5VRX-5 Tang IQ link (C5VRX_WITH_TANG project): the raw IQ goes to a
+ * Tang Primer 25K, which does the FM demodulation, and the receiver state
+ * (gain, AFC, channel) follows on a UART so the FPGA knows what the IQ
+ * stands for. design/iq_link.md in the project has the full description. */
+#pragma once
+#include <stdint.h>
+
+/* XIAO edge pins, so the whole IQ bus reaches the Pmod adapter:
+ * Q0..Q3 = D4 D5 D6 D7, I0..I3 = D8 D9 D0 D1. */
+#define TANG_IQ_GPIOS {23, 24, 11, 12, 8, 9, 1, 0}
+/* The resistor DAC moves to pins the adapter leaves open (D2, D3 and the
+ * MTMS/MTDI/MTCK/MTDO pads); its output is not used in this build. */
+#define TANG_DAC_GPIOS {25, 7, 2, 3, 4, 5, -1, -1}
+/* Telemetry UART TX on D10 (GPIO10), 2 Mbaud 8N1. */
+#define TANG_LINK_GPIO 10
+#define TANG_LINK_BAUD 2000000
+
+void tang_link_start(void);
+/* Send a packet now (after a gain or tuning write). Safe from any task. */
+void tang_link_kick(void);
